// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ORGANIZATIONS & USERS
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sport     String? // e.g., "soccer", "basketball", null = multi-sport
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                User[]
  persons              PersonOrganization[]
  forms                Form[]
  events               Event[]
  eventTemplates       EventTemplate[]
  notes                Note[]
  files                File[]
  formTemplates        FormTemplate[]
  spreadsheets         Spreadsheet[]
  spreadsheetTemplates SpreadsheetTemplate[]
  spreadsheetFolders   SpreadsheetFolder[]
  canvasBoards         CanvasBoard[]
  drawings             Drawing[]
  drawingTemplates     DrawingTemplate[]
  plans                Plan[]
  subscriptions        Subscription[]
  organizationRoles    OrganizationRole[]
  reports              Report[]
  reportTemplates      ReportTemplate[]
  features             OrganizationFeatures?
  aiWorkspaces         AIWorkspace[]
  orgDataSources       OrgDataSource[]

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  avatar         String?
  phone          String?
  authProvider   String    @default("email") // email, google, facebook, instagram
  authProviderId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  // Preferences
  language   String? // User language preference (overrides org default)
  timezone   String? // User timezone (overrides org default)
  dateFormat String? // DD/MM/YYYY, MM/DD/YYYY, YYYY-MM-DD
  timeFormat String? // 12 or 24 hour format

  // Notification Settings (stored as JSON)
  notificationSettings Json? // {email: {...}, push: {...}, sms: {...}}

  // Staff Management
  roleNames   String[] @default([]) // Flexible role tags: "Head Coach", "Physiotherapist", etc.
  permissions String[] @default([]) // System permissions: "admin", "medical_access", etc.

  // Security
  // Note: Password is managed by Supabase Auth
  // Two-Factor Authentication (TOTP)
  twoFactorEnabled   Boolean   @default(false) // User has enabled 2FA
  twoFactorSecret    String? // TOTP secret (encrypted)
  backupCodes        String[]  @default([]) // Recovery codes (hashed)
  twoFactorEnabledAt DateTime? // When 2FA was enabled

  // Platform Admin (for SaaS provider team only)
  isPlatformAdmin Boolean @default(false) // Only set manually for vendor team members

  // Relations
  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Org Context (AI Workspace)
  reportsToId      String?
  reportsTo        User?   @relation("UserReportsTo", fields: [reportsToId], references: [id])
  subordinates     User[]  @relation("UserReportsTo")
  roleAbbreviation String? // e.g. "HOP", "HC"

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  roles              UserRole[]
  notes              Note[]
  files              File[]
  activities         Activity[]
  formResponses      FormResponse[]
  eventAttendance    EventAttendance[]
  plans              Plan[]
  milestones         Milestone[]
  milestoneComments  MilestoneComment[]
  aiConversations    AIConversation[]
  communityTemplates CommunityTemplate[]
  templateReviews    TemplateReview[]
  templateUsages     TemplateUsage[]
  dataChangeLogs     DataChangeLog[]     @relation("DataChangeLogs")
  deletedItems       TrashItem[]         @relation("DeletedItems")

  @@map("users")
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  nationality String?
  phone       String?
  email       String?
  photo       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  // Relations
  users         User[]
  organizations PersonOrganization[]
  notes         Note[]
  files         File[]
  activities    Activity[]

  @@map("persons")
}

// Junction table for many-to-many Person <-> Organization
model PersonOrganization {
  id             String    @id @default(cuid())
  personId       String
  organizationId String
  role           String    @default("player") // player, coach, medical_staff, admin
  position       String? // Forward, Midfielder, etc.
  jerseyNumber   Int?
  status         String    @default("active") // active, injured, inactive
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  tags           String[] // Captain, Starter, Young Talent, etc.

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  formResponses   FormResponse[]
  eventAttendance EventAttendance[]

  @@unique([personId, organizationId])
  @@map("person_organizations")
}

// ============================================
// ROLES & PERMISSIONS
// ============================================

model OrganizationRole {
  id             String       @id @default(cuid())
  name           String // Admin, Coach, Medical Staff, Viewer
  permissions    String[] // manage_players, view_medical_notes, create_forms, etc.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userRoles UserRole[]

  @@unique([name, organizationId])
  @@map("organization_roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// FORMS
// ============================================

model FormTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  category       String // wellness, medical, performance, custom
  schema         Json // Form field definitions
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isPublic       Boolean       @default(false) // Global templates
  createdAt      DateTime      @default(now())

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  forms Form[]

  @@map("form_templates")
}

model Form {
  id             String       @id @default(cuid())
  name           String
  description    String?
  schema         Json // Array of field definitions with conditional logic
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  templateId String?
  template   FormTemplate? @relation(fields: [templateId], references: [id])

  // Scheduling
  scheduleType  String    @default("one_time") // one_time, daily, weekly, monthly
  scheduledAt   DateTime?
  recurringRule Json? // cron-like rule for recurring forms

  // Targeting
  targetType String   @default("all") // all, specific, group
  targetIds  String[] // Person/Group IDs

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  responses FormResponse[]

  @@map("forms")
}

model FormResponse {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  personOrgId String
  personOrg   PersonOrganization @relation(fields: [personOrgId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  responses   Json // Key-value pairs of field responses
  submittedAt DateTime @default(now())

  @@map("form_responses")
}

// ============================================
// EVENTS & CALENDAR
// ============================================

// Event Templates for pre-configured workflows
model EventTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String // training, match, medical, meeting, other

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // What sections are enabled
  sections Json @default("{}") // {spreadsheets: true, notes: true, drawings: true, forms: true, files: true}

  // Pre-configured sections
  sectionConfigs Json @default("{}") // {spreadsheets: [{name: "Match Stats"}], forms: [{name: "Post-Match Report", trigger: "after", delay: 30}]}

  // Duration defaults (in minutes)
  defaultDuration Int @default(120)

  isGlobal  Boolean  @default(false) // Global templates available to all orgs
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  events Event[]

  @@map("event_templates")
}

model Event {
  id             String       @id @default(cuid())
  title          String
  description    String?
  type           String // training, match, medical, other
  startTime      DateTime
  endTime        DateTime
  location       String?
  isRecurring    Boolean      @default(false)
  recurringRule  String? // RRule string
  seriesId       String? // Links instances of recurring events
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Based on template (optional)
  templateId String?
  template   EventTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Linked form (e.g., post-training wellness form)
  linkedFormId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  attendance EventAttendance[]
  notes      Note[]

  @@map("events")
}

model EventAttendance {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  personOrgId String
  personOrg   PersonOrganization @relation(fields: [personOrgId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status     String   @default("invited") // invited, attending, absent, excused
  notes      String?
  recordedAt DateTime @default(now())

  @@unique([eventId, personOrgId])
  @@map("event_attendance")
}

// ============================================
// NOTES
// ============================================

model Note {
  id      String  @id @default(cuid())
  title   String?
  content Json // Tiptap JSON document format

  // Privacy/Visibility
  privacyLevel String @default("public") // public, medical, mental_health, coaches, private

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Linked entities (deprecated - kept for backward compatibility during migration)
  linkedPersonId String?
  linkedPerson   Person? @relation(fields: [linkedPersonId], references: [id], onDelete: SetNull)

  linkedEventId String?
  linkedEvent   Event?  @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)

  // New: Multi-entity linking
  links NoteLink[]

  // Tags for organization
  tags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  @@index([organizationId])
  @@index([authorId])
  @@index([linkedPersonId])
  @@index([linkedEventId])
  @@index([privacyLevel])
  @@map("notes")
}

model NoteLink {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  targetType String // "person" or "event"
  targetId   String

  createdAt DateTime @default(now())

  @@unique([noteId, targetType, targetId])
  @@index([noteId])
  @@index([targetType, targetId])
  @@map("note_links")
}

// ============================================
// FILES
// ============================================

model File {
  id           String  @id @default(cuid())
  name         String
  originalName String // before sanitization
  path         String // Supabase Storage path
  bucket       String  @default("files")
  size         Int
  mimeType     String
  url          String? // Public URL from Supabase Storage

  // Metadata
  description String?
  tags        String[]

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Upload info
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  // Linked entities (deprecated - kept for backward compatibility)
  linkedPersonId String?
  linkedPerson   Person? @relation(fields: [linkedPersonId], references: [id], onDelete: SetNull)

  // New: Multi-entity linking
  links FileLink[]

  // Visibility/Access Control
  visibility String @default("public") // "public", "medical", "coaches", "private"

  // Version control (optional)
  version           Int     @default(1)
  previousVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  @@index([organizationId])
  @@index([uploadedById])
  @@index([linkedPersonId])
  @@index([visibility])
  @@index([mimeType])
  @@index([tags])
  @@map("files")
}

model FileLink {
  id     String @id @default(cuid())
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  targetType String // "person", "event", "note", "plan", "drawing"
  targetId   String

  createdAt DateTime @default(now())

  @@unique([fileId, targetType, targetId])
  @@index([fileId])
  @@index([targetType, targetId])
  @@map("file_links")
}

// ============================================
// SPREADSHEETS
// ============================================

model SpreadsheetTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  category       String // performance, wellness, injury, match, attendance, gps
  schema         Json // Column definitions
  sampleData     Json? // Optional sample rows
  isPublic       Boolean       @default(false) // Global templates available to all orgs
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  spreadsheets Spreadsheet[]

  @@map("spreadsheet_templates")
}

model SpreadsheetFolder {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String? // Optional icon/emoji
  color       String? // Optional color for UI

  // Hierarchy - allow nested folders
  parentId   String?
  parent     SpreadsheetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders SpreadsheetFolder[] @relation("FolderHierarchy")

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Sort order
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spreadsheets Spreadsheet[]

  @@index([organizationId])
  @@index([parentId])
  @@map("spreadsheet_folders")
}

model Spreadsheet {
  id          String  @id @default(cuid())
  name        String
  description String?
  schema      Json // Column definitions
  data        Json // Row data

  // Organization & Folder
  folderId String?
  folder   SpreadsheetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Tags for filtering
  tags String[]

  // Template reference
  templateId String?
  template   SpreadsheetTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Creator
  createdById String?

  // Tabs - future support for multiple sheets in one spreadsheet
  // For now, each spreadsheet is single-tab, but schema prepared for expansion
  tabs Json? @default("[]") // Array of {id, name, schema, data}

  // Versioning
  version Int @default(1)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Permissions
  visibility       String  @default("org") // "org" | "restricted"
  schemaLockedBy   String? // if set, only this user can modify columns
  schemaLockReason String?

  // Metadata
  starred      Boolean   @default(false) // User can star important spreadsheets
  lastOpenedAt DateTime? // Track recent usage
  sharedWith   String[] // User IDs who have access

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  versions    SpreadsheetVersion[]
  permissions SpreadsheetPermission[]

  @@index([organizationId, isDeleted])
  @@index([folderId])
  @@index([tags])
  @@map("spreadsheets")
}

model SpreadsheetVersion {
  id            String      @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  version Int
  schema  Json // Column definitions at this version
  data    Json // Row data at this version

  // Who made this change
  createdById String?
  changeNote  String? // Optional description of what changed

  createdAt DateTime @default(now())

  @@map("spreadsheet_versions")
}

// ============================================
// DATA MANAGEMENT & HISTORICAL TRENDS
// ============================================

// Row-level change tracking for audit trail and history
model DataChangeLog {
  id String @id @default(cuid())

  // What changed
  spreadsheetId String
  rowId         String // The row that was modified

  // Who changed it
  userId         String
  user           User   @relation("DataChangeLogs", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String

  // What happened
  action String // "create" | "update" | "delete" | "restore"

  // The data
  previousData  Json? // null for creates
  newData       Json? // null for deletes
  changedFields String[] // list of field names that changed (for updates)

  // Metadata
  timestamp DateTime @default(now())

  // For grouping bulk operations
  batchId String? // same ID for all changes in a bulk operation

  @@index([spreadsheetId, rowId])
  @@index([spreadsheetId, timestamp])
  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@map("data_change_logs")
}

// Soft delete tracking with trash recovery
model TrashItem {
  id             String @id @default(cuid())
  organizationId String

  // What was deleted
  entityType String // "spreadsheet" | "spreadsheet_row" | "form" | "note" | etc.
  entityId   String
  entityName String // human-readable name for display

  // Context for restoration
  parentId   String? // e.g., spreadsheetId for rows
  parentName String? // e.g., spreadsheet name
  metadata   Json? // any additional context needed for restore

  // Who deleted and when
  deletedBy     String
  deletedByUser User     @relation("DeletedItems", fields: [deletedBy], references: [id], onDelete: Cascade)
  deletedAt     DateTime @default(now())

  // Auto-purge scheduling
  expiresAt DateTime // default: deletedAt + 30 days

  @@index([organizationId, deletedAt])
  @@index([organizationId, entityType])
  @@index([expiresAt])
  @@map("trash_items")
}

// Table-level permissions for data access control
model SpreadsheetPermission {
  id            String      @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  // Who has permission
  grantType  String // "user" | "role" | "permission"
  grantValue String // userId, role name, or permission name

  // What permission
  accessLevel String // "view" | "edit" | "admin"

  // Audit
  grantedBy String
  grantedAt DateTime @default(now())

  @@unique([spreadsheetId, grantType, grantValue])
  @@index([spreadsheetId])
  @@map("spreadsheet_permissions")
}

// ============================================
// CANVAS
// ============================================

model CanvasBoard {
  id             String       @id @default(cuid())
  name           String
  data           Json // Drawing data
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  @@map("canvas_boards")
}

// Tactical drawings/whiteboard templates
model DrawingTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String // "formation", "drill", "set_piece", "tactics"
  sport       String  @default("football") // "football", "rugby", "basketball"

  // Template data
  data         Json // Excalidraw scene data
  thumbnailUrl String?

  // Global vs organization-specific
  isGlobal       Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Community features
  downloads Int    @default(0)
  rating    Float?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawings Drawing[]

  @@index([isGlobal, category])
  @@index([organizationId, category])
  @@index([category, downloads])
  @@map("drawing_templates")
}

// Tactical drawings/whiteboard instances
model Drawing {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Type/category
  type String? // "formation", "drill", "tactics", "set_piece", "session_plan"
  tags String[]

  // Excalidraw data
  data Json // Excalidraw scene data

  // Preview image
  thumbnailUrl String? // PNG preview for library view

  // Linked to entities
  linkedToType String? // "event", "plan", "note"
  linkedToId   String?

  // Template reference
  isTemplate Boolean          @default(false)
  templateId String?
  template   DrawingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Sharing
  isPublic   Boolean @default(false)
  shareToken String? @unique

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, updatedAt])
  @@index([organizationId, type])
  @@index([organizationId, createdBy])
  @@index([organizationId, name])
  @@index([organizationId, description])
  @@index([organizationId, tags])
  @@map("drawings")
}

// ============================================
// PLANNER
// ============================================

model Plan {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Type/category
  type String // "season", "player_development", "rehabilitation", "event_prep", "custom"

  // Duration
  startDate DateTime
  endDate   DateTime

  // Status
  status String @default("not_started") // "not_started", "in_progress", "complete", "on_hold"

  // Linked to entities
  linkedToType String? // "player", "event", "team", "person"
  linkedToId   String?

  // Ownership
  ownerId String // who's responsible
  owner   User   @relation(fields: [ownerId], references: [id])

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Milestones
  milestones Milestone[]

  // Visibility & Publishing
  isPublic    Boolean   @default(false)
  isTemplate  Boolean   @default(false)
  publishedAt DateTime?

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([linkedToType, linkedToId])
  @@map("plans")
}

model Milestone {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Timeline
  startDate DateTime?
  endDate   DateTime?
  dueDate   DateTime? // if single deadline

  // Order
  order Int @default(0) // for sorting

  // Status
  status      String    @default("pending") // "pending", "in_progress", "complete", "blocked"
  completedAt DateTime?
  completedBy String?

  // Assignment
  assignedTo String? // user ID
  assignee   User?   @relation(fields: [assignedTo], references: [id])

  // Progress (0-100)
  progress Int @default(0)

  // Links to other entities
  links MilestoneLink[]

  // Comments/updates
  comments MilestoneComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search (managed outside Prisma)
  search_vector Unsupported("tsvector")?

  @@index([planId, order])
  @@index([planId, status])
  @@map("milestones")
}

model MilestoneLink {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  targetType String // "note", "form", "event", "file", "spreadsheet", "drawing"
  targetId   String

  createdAt DateTime @default(now())

  @@unique([milestoneId, targetType, targetId])
  @@index([milestoneId])
  @@index([targetType, targetId])
  @@map("milestone_links")
}

model MilestoneComment {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  content  String
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([milestoneId])
  @@map("milestone_comments")
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique // One subscription per organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan               String // free, pro, enterprise
  status             String // active, cancelled, past_due
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  stripeCustomerId     String?
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

// ============================================
// ACTIVITY LOG
// ============================================

model Activity {
  id     String  @id @default(cuid())
  type   String // player_created, form_submitted, event_created, etc.
  data   Json
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  createdAt DateTime @default(now())

  @@map("activities")
}

// ============================================
// REPORTS
// ============================================

model ReportTemplate {
  id          String @id @default(cuid())
  name        String
  description String
  category    String // "player", "team", "medical", "performance"

  // Template config
  config   Json // {dataSources, visualization, filters, etc.}
  sections Json? // For multi-section dashboards

  // Global vs user-created
  isGlobal       Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy String?

  // Community Hub
  downloads Int    @default(0)
  rating    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([organizationId])
  @@index([isGlobal, category])
  @@map("report_templates")
}

model Report {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Type
  type String // "single_chart", "dashboard", "table"

  // Based on template?
  templateId String?
  template   ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Report configuration
  config Json // {dataSources, visualization, xAxis, yAxis, filters, chartOptions}

  // Multi-section dashboard
  sections Json? // [{type: "chart", config: {...}}, {type: "table", config: {...}}]

  // AI Insights
  insights Json? // AI-generated insights

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Access
  isPublic   Boolean @default(false)
  shareToken String? @unique

  // Scheduling
  schedule ReportSchedule?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([createdBy])
  @@index([shareToken])
  @@map("reports")
}

model ReportSchedule {
  id       String @id @default(cuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  frequency  String // "daily", "weekly", "monthly"
  time       String // "09:00"
  dayOfWeek  Int? // 1-7 for weekly
  dayOfMonth Int? // 1-31 for monthly

  // Who gets it
  recipients String[] // user IDs or email addresses
  format     String // "pdf", "link"

  isActive Boolean   @default(true)
  lastSent DateTime?
  nextSend DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, nextSend])
  @@map("report_schedules")
}

// Legacy reportTemplates table (managed outside Prisma, preserved for backward compatibility)
model reportTemplates {
  id             String   @id @default(cuid())
  name           String
  description    String?
  category       String?
  config         Json
  sections       Json?
  isGlobal       Boolean  @default(false)
  organizationId String?
  downloads      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@ignore
}

// ============================================
// AI ASSISTANT & TOOLING
// ============================================

model AIConversation {
  id     String @id @default(cuid())
  orgId  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String // auto-generated summary
  messages AIMessage[]

  // Context
  contextType String? // "player", "event", "report"
  contextId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, userId])
  @@index([orgId, createdAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // "user" or "assistant"
  content String @db.Text

  // If AI took actions
  actions Json? // [{type: "event_created", id: "event_123"}]

  // Tool calls made
  toolCalls Json?

  // Token usage for cost tracking
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AIInsight {
  id    String @id @default(cuid())
  orgId String

  type     String // "injury_risk", "wellness_decline", "load_spike"
  priority String // "high", "medium", "low"

  title       String
  description String @db.Text
  data        Json // detailed data backing insight

  // Related entities
  playerIds String[]

  // Status
  status String @default("active") // "active", "dismissed", "acted_on"

  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  @@index([orgId, status])
  @@index([orgId, priority])
  @@index([orgId, createdAt])
  @@map("ai_insights")
}

model AISettings {
  id     String @id @default(cuid())
  orgId  String @unique
  userId String @unique

  // Proactive Insights
  injuryRiskAlerts     Boolean @default(true)
  wellnessAlerts       Boolean @default(true)
  loadAlerts           Boolean @default(true)
  formCompletionAlerts Boolean @default(true)

  // Alert Frequency
  alertFrequency String @default("real_time") // "real_time", "daily_digest", "weekly_summary"

  // Data Access Control
  dataAccess Json @default("{\"playerWellness\": true, \"loadData\": true, \"medicalNotes\": false, \"formResponses\": true, \"eventAttendance\": true, \"privateNotes\": false}")

  // Cost Controls
  monthlyTokenLimit   Int      @default(1000000) // 1M tokens per month
  tokensUsedThisMonth Int      @default(0)
  lastResetAt         DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

model AICostTracking {
  id             String  @id @default(cuid())
  orgId          String
  userId         String
  conversationId String?

  inputTokens  Int
  outputTokens Int
  totalCost    Float // in USD

  // Metadata
  model    String @default("claude-sonnet-4")
  endpoint String // "chat", "tool_call", "insight_generation"

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_cost_tracking")
}

// ============================================
// COMMUNITY TEMPLATES HUB
// ============================================

model CommunityTemplate {
  id String @id @default(cuid())

  // Type
  type String // "form", "report", "drawing", "plan", "spreadsheet"

  // Info
  name            String
  description     String
  longDescription String? @db.Text

  // Categorization
  category String // "wellness", "performance", "medical", "tactics", "training"
  sport    String // "football", "rugby", "basketball", "multi-sport"
  tags     String[]
  features String[] // what's included

  // Template data
  config Json // the actual template configuration

  // Preview
  previewImage String?
  thumbnailUrl String?

  // Author
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String? // cached author name for display
  orgName    String? // author's org name (for display)

  // Official templates
  isOfficial Boolean @default(false)
  isFeatured Boolean @default(false)

  // Publishing settings
  isPublic           Boolean @default(true)
  allowModifications Boolean @default(true)

  // Stats
  downloads   Int    @default(0)
  usageCount  Int    @default(0)
  rating      Float?
  reviewCount Int    @default(0)

  // Reviews
  reviews TemplateReview[]

  // Status
  status          String  @default("published") // "draft", "pending_review", "published", "archived", "rejected"
  moderationNotes String? @db.Text

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Usage tracking
  usages TemplateUsage[]

  @@index([type, status])
  @@index([category, status])
  @@index([sport, status])
  @@index([isOfficial, isFeatured])
  @@index([status, publishedAt])
  @@index([authorId])
  @@map("community_templates")
}

model TemplateReview {
  id         String            @id @default(cuid())
  templateId String
  template   CommunityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  content String @db.Text

  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, userId]) // one review per user per template
  @@index([templateId])
  @@index([userId])
  @@index([rating])
  @@map("template_reviews")
}

model TemplateUsage {
  id         String            @id @default(cuid())
  templateId String
  template   CommunityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What they created from it
  createdType String // "form", "report", "drawing", "plan", "spreadsheet"
  createdId   String?
  createdName String? // name of the item they created

  usedAt DateTime @default(now())

  @@index([templateId])
  @@index([userId])
  @@index([usedAt])
  @@map("template_usages")
}

// ============================================
// ORGANIZATION FEATURES
// ============================================

// ============================================
// AI WORKSPACE
// ============================================

model AIWorkspace {
  id   String @id @default(cuid())
  name String

  // Artifact type
  artifactType String // "reports", "whiteboards", "uiPages", "plans"

  // Status
  status String @default("draft") // "generating", "draft", "updating", "ready", "published", "syncing"

  // Initial prompt
  initialPrompt String @db.Text

  // Artifact configuration and data (JSON)
  artifactData Json? // stores reportConfig, whiteboardConfig, uiPageConfig, or planConfig

  // Structured inputs from user (JSON)
  structuredInputs Json? // stores criteria, artifact-specific inputs, etc.

  // Generated content
  generatedContent Json?

  // Publishing
  publishedAt DateTime?
  publishedTo Json? // Array of {type, id, name} destinations

  // Version control
  version Int @default(1)

  // Organization and ownership
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages AIWorkspaceMessage[]

  @@index([organizationId])
  @@index([userId])
  @@index([artifactType])
  @@index([status])
  @@map("ai_workspaces")
}

model AIWorkspaceMessage {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   AIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  role     String // "user", "assistant", "system"
  content  String  @db.Text
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_workspace_messages")
}

model OrganizationFeatures {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Main Navigation Features (13 sections - added aiWorkspace)
  aiWorkspaceEnabled  Boolean @default(true)
  aiEnabled           Boolean @default(true)
  playersEnabled      Boolean @default(true)
  formsEnabled        Boolean @default(true)
  reportsEnabled      Boolean @default(true)
  calendarEnabled     Boolean @default(true)
  messagesEnabled     Boolean @default(true)
  notesEnabled        Boolean @default(true)
  spreadsheetsEnabled Boolean @default(true)
  canvasEnabled       Boolean @default(true)
  filesEnabled        Boolean @default(true)
  plannerEnabled      Boolean @default(true)
  templatesEnabled    Boolean @default(true)

  // Sub-features: Reports
  reportsBuilderEnabled    Boolean @default(true)
  reportsTemplatesEnabled  Boolean @default(true)
  reportsSchedulingEnabled Boolean @default(true)
  reportsAiInsightsEnabled Boolean @default(true)
  reportsSharingEnabled    Boolean @default(true)

  // Sub-features: Calendar
  calendarAttendanceEnabled   Boolean @default(true)
  calendarFormsEnabled        Boolean @default(true)
  calendarDrawingsEnabled     Boolean @default(true)
  calendarSpreadsheetsEnabled Boolean @default(true)
  calendarNotesEnabled        Boolean @default(true)
  calendarFilesEnabled        Boolean @default(true)

  // Sub-features: Forms
  formsBuilderEnabled    Boolean @default(true)
  formsResponsesEnabled  Boolean @default(true)
  formsSchedulingEnabled Boolean @default(true)

  // Sub-features: Players
  playersNotesEnabled       Boolean @default(true)
  playersFilesEnabled       Boolean @default(true)
  playersMedicalDataEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_features")
}

// ============================================
// AI WORKSPACE CONTEXT
// ============================================

model OrgDataSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceType       String // wellness, gps, medical, match_stats, video
  availableMetrics String[] // ["rpe", "wellness_score", "load"]
  isActive         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("org_data_sources")
}
