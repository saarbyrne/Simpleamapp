generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  sport                String?
  logo                 String?
  primaryColor         String?
  secondaryColor       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  aiConversations      AIConversation[]
  aiCostTracking       AICostTracking[]
  aiInsights           AIInsight[]
  aiSettings           AISettings?
  aiWorkspaces         AIWorkspace[]
  canvasBoards         CanvasBoard[]
  drawingTemplates     DrawingTemplate[]
  drawings             Drawing[]
  eventTemplates       EventTemplate[]
  events               Event[]
  files                File[]
  formTemplates        FormTemplate[]
  forms                Form[]
  notes                Note[]
  orgDataSources       OrgDataSource[]
  features             OrganizationFeatures?
  organizationRoles    OrganizationRole[]
  persons              PersonOrganization[]
  plans                Plan[]
  reportTemplates      ReportTemplate[]
  reports              Report[]
  spreadsheetFolders   SpreadsheetFolder[]
  spreadsheetTemplates SpreadsheetTemplate[]
  spreadsheets         Spreadsheet[]
  subscriptions        Subscription?
  users                User[]

  @@map("organizations")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String
  avatar               String?
  authProvider         String              @default("email")
  authProviderId       String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  lastLoginAt          DateTime?
  organizationId       String
  personId             String?
  phone                String?
  language             String?
  timezone             String?
  dateFormat           String?
  timeFormat           String?
  theme                String?
  experimentalTheme    String?
  notificationSettings Json?
  roleNames            String[]            @default([])
  permissions          String[]            @default([])
  isPlatformAdmin      Boolean             @default(false)
  twoFactorEnabled     Boolean             @default(false)
  twoFactorSecret      String?
  backupCodes          String[]            @default([])
  twoFactorEnabledAt   DateTime?
  reportsToId          String?
  roleAbbreviation     String?
  activities           Activity[]
  aiConversations      AIConversation[]
  communityTemplates   CommunityTemplate[]
  dataChangeLogs       DataChangeLog[]     @relation("DataChangeLogs")
  eventAttendance      EventAttendance[]
  files                File[]
  formResponses        FormResponse[]
  milestoneComments    MilestoneComment[]
  milestones           Milestone[]
  notes                Note[]
  plans                Plan[]
  templateReviews      TemplateReview[]
  templateUsages       TemplateUsage[]
  deletedItems         TrashItem[]         @relation("DeletedItems")
  roles                UserRole[]
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person               Person?             @relation(fields: [personId], references: [id])
  reportsTo            User?               @relation("UserReportsTo", fields: [reportsToId], references: [id])
  subordinates         User[]              @relation("UserReportsTo")

  @@map("users")
}

model Person {
  id            String                   @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  nationality   String?
  phone         String?
  email         String?
  photo         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  search_vector Unsupported("tsvector")?
  activities    Activity[]
  files         File[]
  notes         Note[]
  organizations PersonOrganization[]
  users         User[]

  @@map("persons")
}

model PersonOrganization {
  id              String            @id @default(cuid())
  personId        String
  organizationId  String
  role            String            @default("player")
  position        String?
  jerseyNumber    Int?
  status          String            @default("active")
  joinedAt        DateTime          @default(now())
  leftAt          DateTime?
  tags            String[]
  eventAttendance EventAttendance[]
  formResponses   FormResponse[]
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person          Person            @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, organizationId])
  @@map("person_organizations")
}

model OrganizationRole {
  id             String       @id @default(cuid())
  name           String
  permissions    String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]

  @@unique([name, organizationId])
  @@map("organization_roles")
}

model UserRole {
  id     String           @id @default(cuid())
  userId String
  roleId String
  role   OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model FormTemplate {
  id             String                   @id @default(cuid())
  name           String
  description    String?
  category       String
  schema         Json
  organizationId String?
  isPublic       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  search_vector  Unsupported("tsvector")?
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  forms          Form[]

  @@map("form_templates")
}

model Form {
  id             String                   @id @default(cuid())
  name           String
  description    String?
  schema         Json
  organizationId String
  templateId     String?
  scheduleType   String                   @default("one_time")
  scheduledAt    DateTime?
  recurringRule  Json?
  targetType     String                   @default("all")
  targetIds      String[]
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  search_vector  Unsupported("tsvector")?
  responses      FormResponse[]
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       FormTemplate?            @relation(fields: [templateId], references: [id])

  @@map("forms")
}

model FormResponse {
  id          String             @id @default(cuid())
  formId      String
  personOrgId String
  userId      String?
  responses   Json
  submittedAt DateTime           @default(now())
  form        Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  personOrg   PersonOrganization @relation(fields: [personOrgId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id])

  @@map("form_responses")
}

model EventTemplate {
  id              String                   @id @default(cuid())
  name            String
  description     String?
  type            String
  organizationId  String
  sections        Json                     @default("{}")
  sectionConfigs  Json                     @default("{}")
  defaultDuration Int                      @default(120)
  isGlobal        Boolean                  @default(false)
  createdBy       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  search_vector   Unsupported("tsvector")?
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events          Event[]

  @@map("event_templates")
}

model Event {
  id             String                   @id @default(cuid())
  title          String
  description    String?
  type           String
  startTime      DateTime
  endTime        DateTime
  location       String?
  isRecurring    Boolean                  @default(false)
  recurringRule  String?
  organizationId String
  linkedFormId   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  templateId     String?
  seriesId       String?
  search_vector  Unsupported("tsvector")?
  attendance     EventAttendance[]
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       EventTemplate?           @relation(fields: [templateId], references: [id])
  notes          Note[]

  @@map("events")
}

model EventAttendance {
  id          String             @id @default(cuid())
  eventId     String
  personOrgId String
  userId      String?
  status      String             @default("invited")
  notes       String?
  recordedAt  DateTime           @default(now())
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personOrg   PersonOrganization @relation(fields: [personOrgId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id])

  @@unique([eventId, personOrgId])
  @@map("event_attendance")
}

model Note {
  id             String                   @id @default(cuid())
  title          String?
  content        Json
  privacyLevel   String                   @default("public")
  organizationId String
  authorId       String
  linkedPersonId String?
  linkedEventId  String?
  tags           String[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  search_vector  Unsupported("tsvector")?
  links          NoteLink[]
  author         User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  linkedEvent    Event?                   @relation(fields: [linkedEventId], references: [id])
  linkedPerson   Person?                  @relation(fields: [linkedPersonId], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([authorId])
  @@index([linkedPersonId])
  @@index([linkedEventId])
  @@index([privacyLevel])
  @@map("notes")
}

model NoteLink {
  id         String   @id @default(cuid())
  noteId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, targetType, targetId])
  @@index([noteId])
  @@index([targetType, targetId])
  @@map("note_links")
}

model File {
  id                String                   @id @default(cuid())
  name              String
  path              String
  size              Int
  mimeType          String
  organizationId    String
  uploadedById      String
  linkedPersonId    String?
  tags              String[]
  createdAt         DateTime                 @default(now())
  search_vector     Unsupported("tsvector")?
  originalName      String
  bucket            String                   @default("files")
  url               String?
  description       String?
  visibility        String                   @default("public")
  version           Int                      @default(1)
  previousVersionId String?
  updatedAt         DateTime                 @updatedAt
  links             FileLink[]
  linkedPerson      Person?                  @relation(fields: [linkedPersonId], references: [id])
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy        User                     @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([uploadedById])
  @@index([linkedPersonId])
  @@index([visibility])
  @@index([mimeType])
  @@index([tags])
  @@map("files")
}

model FileLink {
  id         String   @id @default(cuid())
  fileId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, targetType, targetId])
  @@index([fileId])
  @@index([targetType, targetId])
  @@map("file_links")
}

model SpreadsheetTemplate {
  id             String                   @id @default(cuid())
  name           String
  description    String?
  category       String
  schema         Json
  sampleData     Json?
  isPublic       Boolean                  @default(false)
  organizationId String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  search_vector  Unsupported("tsvector")?
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spreadsheets   Spreadsheet[]

  @@map("spreadsheet_templates")
}

model SpreadsheetFolder {
  id             String              @id @default(cuid())
  name           String
  description    String?
  icon           String?
  color          String?
  parentId       String?
  organizationId String
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         SpreadsheetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders     SpreadsheetFolder[] @relation("FolderHierarchy")
  spreadsheets   Spreadsheet[]

  @@index([organizationId])
  @@index([parentId])
  @@map("spreadsheet_folders")
}

model Spreadsheet {
  id               String                   @id @default(cuid())
  name             String
  description      String?
  schema           Json
  data             Json
  organizationId   String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  templateId       String?
  createdById      String?
  version          Int                      @default(1)
  search_vector    Unsupported("tsvector")?
  isDeleted        Boolean                  @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  visibility       String                   @default("org")
  schemaLockedBy   String?
  schemaLockReason String?
  folderId         String?
  tags             String[]
  tabs             Json?                    @default("[]")
  starred          Boolean                  @default(false)
  lastOpenedAt     DateTime?
  sharedWith       String[]
  dataChangeLogs   DataChangeLog[]
  permissions      SpreadsheetPermission[]
  versions         SpreadsheetVersion[]
  folder           SpreadsheetFolder?       @relation(fields: [folderId], references: [id])
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template         SpreadsheetTemplate?     @relation(fields: [templateId], references: [id])

  @@index([organizationId, isDeleted])
  @@index([folderId])
  @@index([tags])
  @@map("spreadsheets")
}

model SpreadsheetVersion {
  id            String      @id @default(cuid())
  spreadsheetId String
  version       Int
  schema        Json
  data          Json
  createdById   String?
  changeNote    String?
  createdAt     DateTime    @default(now())
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@map("spreadsheet_versions")
}

model DataChangeLog {
  id             String      @id @default(cuid())
  spreadsheetId  String
  rowId          String
  userId         String
  organizationId String
  action         String
  previousData   Json?
  newData        Json?
  changedFields  String[]
  timestamp      DateTime    @default(now())
  batchId        String?
  spreadsheet    Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)
  user           User        @relation("DataChangeLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([spreadsheetId, rowId])
  @@index([spreadsheetId, timestamp])
  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@map("data_change_logs")
}

model TrashItem {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  entityName     String
  parentId       String?
  parentName     String?
  metadata       Json?
  deletedBy      String
  deletedAt      DateTime @default(now())
  expiresAt      DateTime
  deletedByUser  User     @relation("DeletedItems", fields: [deletedBy], references: [id], onDelete: Cascade)

  @@index([organizationId, deletedAt])
  @@index([organizationId, entityType])
  @@index([expiresAt])
  @@map("trash_items")
}

model SpreadsheetPermission {
  id            String      @id @default(cuid())
  spreadsheetId String
  grantType     String
  grantValue    String
  accessLevel   String
  grantedBy     String
  grantedAt     DateTime    @default(now())
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, grantType, grantValue])
  @@index([spreadsheetId])
  @@map("spreadsheet_permissions")
}

model CanvasBoard {
  id             String                   @id @default(cuid())
  name           String
  data           Json
  organizationId String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  search_vector  Unsupported("tsvector")?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("canvas_boards")
}

model DrawingTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  category       String
  sport          String        @default("football")
  data           Json
  thumbnailUrl   String?
  isGlobal       Boolean       @default(false)
  organizationId String?
  downloads      Int           @default(0)
  rating         Float?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  drawings       Drawing[]

  @@index([isGlobal, category])
  @@index([organizationId, category])
  @@index([category, downloads])
  @@map("drawing_templates")
}

model Drawing {
  id             String           @id @default(cuid())
  name           String
  description    String?
  type           String?
  tags           String[]
  data           Json
  thumbnailUrl   String?
  linkedToType   String?
  linkedToId     String?
  isTemplate     Boolean          @default(false)
  templateId     String?
  isPublic       Boolean          @default(false)
  shareToken     String?          @unique
  organizationId String
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       DrawingTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId, updatedAt])
  @@index([organizationId, type])
  @@index([organizationId, createdBy])
  @@index([organizationId, name])
  @@index([organizationId, description])
  @@index([organizationId, tags])
  @@map("drawings")
}

model Plan {
  id             String                   @id @default(cuid())
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  organizationId String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  search_vector  Unsupported("tsvector")?
  type           String
  status         String                   @default("not_started")
  linkedToType   String?
  linkedToId     String?
  ownerId        String
  isPublic       Boolean                  @default(false)
  isTemplate     Boolean                  @default(false)
  publishedAt    DateTime?
  createdBy      String
  milestones     Milestone[]
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User                     @relation(fields: [ownerId], references: [id])

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([linkedToType, linkedToId])
  @@map("plans")
}

model Milestone {
  id            String                   @id @default(cuid())
  planId        String
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  dueDate       DateTime?
  order         Int                      @default(0)
  status        String                   @default("pending")
  completedAt   DateTime?
  completedBy   String?
  assignedTo    String?
  progress      Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  search_vector Unsupported("tsvector")?
  comments      MilestoneComment[]
  links         MilestoneLink[]
  assignee      User?                    @relation(fields: [assignedTo], references: [id])
  plan          Plan                     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
  @@index([planId, status])
  @@map("milestones")
}

model MilestoneLink {
  id          String    @id @default(cuid())
  milestoneId String
  targetType  String
  targetId    String
  createdAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, targetType, targetId])
  @@index([milestoneId])
  @@index([targetType, targetId])
  @@map("milestone_links")
}

model MilestoneComment {
  id          String    @id @default(cuid())
  milestoneId String
  content     String
  authorId    String
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_comments")
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  plan                 String
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  data      Json
  userId    String?
  personId  String?
  createdAt DateTime @default(now())
  person    Person?  @relation(fields: [personId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("activities")
}

model ReportTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String
  category       String
  config         Json
  sections       Json?
  isGlobal       Boolean       @default(false)
  organizationId String?
  createdBy      String?
  downloads      Int           @default(0)
  rating         Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports        Report[]

  @@index([organizationId])
  @@index([isGlobal, category])
  @@map("report_templates")
}

model Report {
  id             String          @id @default(cuid())
  name           String
  description    String?
  type           String
  templateId     String?
  config         Json
  sections       Json?
  insights       Json?
  organizationId String
  isPublic       Boolean         @default(false)
  shareToken     String?         @unique
  createdBy      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  schedule       ReportSchedule?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       ReportTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([createdBy])
  @@index([shareToken])
  @@map("reports")
}

model ReportSchedule {
  id         String    @id @default(cuid())
  reportId   String    @unique
  frequency  String
  time       String
  dayOfWeek  Int?
  dayOfMonth Int?
  recipients String[]
  format     String
  isActive   Boolean   @default(true)
  lastSent   DateTime?
  nextSend   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  report     Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([isActive, nextSend])
  @@map("report_schedules")
}

model AIConversation {
  id             String       @id @default(cuid())
  organizationId String       @map("orgId")
  userId         String
  title          String
  contextType    String?
  contextId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]

  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  actions        Json?
  toolCalls      Json?
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AIInsight {
  id             String       @id @default(cuid())
  organizationId String       @map("orgId")
  type           String
  priority       String
  title          String
  description    String
  data           Json
  playerIds      String[]
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  dismissedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, createdAt])
  @@map("ai_insights")
}

model AISettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique @map("orgId")
  userId               String       @unique
  injuryRiskAlerts     Boolean      @default(true)
  wellnessAlerts       Boolean      @default(true)
  loadAlerts           Boolean      @default(true)
  formCompletionAlerts Boolean      @default(true)
  alertFrequency       String       @default("real_time")
  dataAccess           Json         @default("{\"loadData\": true, \"medicalNotes\": false, \"privateNotes\": false, \"formResponses\": true, \"playerWellness\": true, \"eventAttendance\": true}")
  monthlyTokenLimit    Int          @default(1000000)
  tokensUsedThisMonth  Int          @default(0)
  lastResetAt          DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AICostTracking {
  id             String       @id @default(cuid())
  organizationId String       @map("orgId")
  userId         String
  conversationId String?
  inputTokens    Int
  outputTokens   Int
  totalCost      Float
  model          String       @default("claude-sonnet-4")
  endpoint       String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_cost_tracking")
}

model CommunityTemplate {
  id                 String           @id @default(cuid())
  type               String
  name               String
  description        String
  longDescription    String?
  category           String
  sport              String
  tags               String[]
  features           String[]
  config             Json
  previewImage       String?
  thumbnailUrl       String?
  authorId           String?
  authorName         String?
  orgName            String?
  isOfficial         Boolean          @default(false)
  isFeatured         Boolean          @default(false)
  isPublic           Boolean          @default(true)
  allowModifications Boolean          @default(true)
  downloads          Int              @default(0)
  usageCount         Int              @default(0)
  rating             Float?
  reviewCount        Int              @default(0)
  status             String           @default("published")
  moderationNotes    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  publishedAt        DateTime?
  author             User?            @relation(fields: [authorId], references: [id])
  reviews            TemplateReview[]
  usages             TemplateUsage[]

  @@index([type, status])
  @@index([category, status])
  @@index([sport, status])
  @@index([isOfficial, isFeatured])
  @@index([status, publishedAt])
  @@index([authorId])
  @@map("community_templates")
}

model TemplateReview {
  id           String            @id @default(cuid())
  templateId   String
  userId       String
  rating       Int
  content      String
  helpfulCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  template     CommunityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([templateId])
  @@index([userId])
  @@index([rating])
  @@map("template_reviews")
}

model TemplateUsage {
  id          String            @id @default(cuid())
  templateId  String
  userId      String
  createdType String
  createdId   String?
  createdName String?
  usedAt      DateTime          @default(now())
  template    CommunityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId])
  @@index([usedAt])
  @@map("template_usages")
}

model AIWorkspace {
  id               String               @id @default(cuid())
  name             String
  artifactType     String
  status           String               @default("draft")
  initialPrompt    String
  artifactData     Json?
  generatedContent Json?
  publishedAt      DateTime?
  publishedTo      Json?
  version          Int                  @default(1)
  organizationId   String
  userId           String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  structuredInputs Json?
  messages         AIWorkspaceMessage[]
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([artifactType])
  @@index([status])
  @@map("ai_workspaces")
}

model AIWorkspaceMessage {
  id          String      @id @default(cuid())
  workspaceId String
  role        String
  content     String
  createdAt   DateTime    @default(now())
  isSystem    Boolean     @default(false)
  workspace   AIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_workspace_messages")
}

