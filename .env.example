# ============================================
# ANALYTICS CONFIGURATION
# ============================================
# All analytics services are configured with FREE tier limits
# No hidden costs - see ANALYTICS.md for details

# --------------------------------------------
# Vercel Analytics (FREE - Unlimited)
# --------------------------------------------
# No configuration needed - works automatically when deployed to Vercel
# Local development: analytics will not send data

# --------------------------------------------
# Vercel Speed Insights (FREE - Unlimited)
# --------------------------------------------
# No configuration needed - works automatically when deployed to Vercel

# --------------------------------------------
# Sentry - Error Tracking
# FREE TIER: 5,000 errors/month, 10,000 performance units/month
# --------------------------------------------
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Optional: For source map uploads (build time only)
# SENTRY_ORG=your-org-name
# SENTRY_PROJECT=your-project-name
# SENTRY_AUTH_TOKEN=your-auth-token

# --------------------------------------------
# PostHog - Product Analytics
# FREE TIER: 1,000,000 events/month
# --------------------------------------------
# Get your key from: https://app.posthog.com/project/settings
# US Cloud (recommended): https://us.i.posthog.com
# EU Cloud: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# EXISTING CONFIGURATION
# ============================================
# Add your existing environment variables below this section
