# ============================================
# ANALYTICS CONFIGURATION
# ============================================
# All analytics services are configured with FREE tier limits
# No hidden costs - see ANALYTICS.md for details

# --------------------------------------------
# Vercel Analytics (FREE - Unlimited)
# --------------------------------------------
# No configuration needed - works automatically when deployed to Vercel
# Local development: analytics will not send data

# --------------------------------------------
# Vercel Speed Insights (FREE - Unlimited)
# --------------------------------------------
# No configuration needed - works automatically when deployed to Vercel

# --------------------------------------------
# Sentry - Error Tracking
# FREE TIER: 5,000 errors/month, 10,000 performance units/month
# --------------------------------------------
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Optional: For source map uploads (build time only)
# SENTRY_ORG=your-org-name
# SENTRY_PROJECT=your-project-name
# SENTRY_AUTH_TOKEN=your-auth-token

# --------------------------------------------
# PostHog - Product Analytics
# FREE TIER: 1,000,000 events/month
# --------------------------------------------
# Get your key from: https://app.posthog.com/project/settings
# US Cloud (recommended): https://us.i.posthog.com
# EU Cloud: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Supabase Database URLs
# Get these from: https://supabase.com/dashboard/project/_/settings/database
#
# DATABASE_URL: Use the "Transaction" pooler URL for application queries
# Example: postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# DIRECT_URL: Use the direct database connection for migrations
# Example: postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-eu-west-1.compute.amazonaws.com:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================
# AUTHENTICATION
# ============================================
# Supabase Authentication
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# STRIPE BILLING (Optional)
# ============================================
# Required for subscription management
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Plan pricing (monthly, in cents or dollars - adjust as needed)
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=price_xxx

# ============================================
# PLATFORM ADMIN CONFIGURATION
# ============================================
# Platform admin access is controlled via database only
# To grant platform admin access, run this SQL:
# UPDATE users SET "isPlatformAdmin" = true WHERE email = 'your-email@yourcompany.com';

# Optional: Configure plan pricing for platform admin billing dashboard
PLAN_PRICING_PRO=29
PLAN_PRICING_ENTERPRISE=99

# ============================================
# FILE STORAGE
# ============================================
# Supabase Storage bucket name
NEXT_PUBLIC_STORAGE_BUCKET=files

# ============================================
# FIREBASE CONFIGURATION (for Real-time Chat)
# ============================================
# Firebase Chat System
# Get these from: https://console.firebase.google.com/project/simpleam-80594/settings/general
# 1. Go to Project Settings > General
# 2. Scroll to "Your apps" section
# 3. If no web app exists, click "Add app" > Web
# 4. Copy the config values below
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBfSJkNiLY7r6p80Bb4aCm9W7Vci8kTk8Q
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=simpleam-80594.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=simpleam-80594
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=simpleam-80594.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=672837818288
NEXT_PUBLIC_FIREBASE_APP_ID=1:672837818288:web:c14efb48186ba231166875

